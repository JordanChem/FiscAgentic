# Clés API nécessaires pour l'application
# Copiez ce fichier en .env et remplissez vos clés API

# ── Providers LLM (via LiteLLM) ──────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
# Anthropic / Claude (ajouté pour la comparaison de modèles)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Recherche & sources ──────────────────────────────────────────────────────
SERPAPI_API_KEY=your_serpapi_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FISCALONLINE_TOKEN=your_fiscalonline_token_here

# ── Persistance (Supabase) ───────────────────────────────────────────────────
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# ── Observabilité : tracing des agents (Langfuse, optionnel) ─────────────────
# Si défini, chaque question (app live ET éval) produit UNE trace dans Langfuse :
# une génération par agent (entrée/sortie/coût/latence), regroupée par session
# utilisateur, + spans des étapes non-LLM (recherche, dédup, scraping) et artefacts
# (scores de routage, sources vérifiées, ranking). Le 👍/👎 utilisateur est attaché
# en score. Sans ces clés, le pipeline tourne normalement (aucune trace émise).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Évaluation : dashboard qualité (Confident AI / deepeval, optionnel) ──────
# Alternative à `deepeval login`. Le golden scoring fonctionne aussi sans (rapport console).
CONFIDENT_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# API FastAPI (service consommé par le proxy fiscalonline.fr)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Authentification du proxy ────────────────────────────────────────────────
# Secret partagé attendu dans l'en-tête X-API-Key. Plusieurs valeurs séparées par
# des virgules sont acceptées : c'est ce qui permet de tourner une clé sans
# coupure (ajouter la nouvelle, migrer le proxy, retirer l'ancienne).
# Générer avec :  openssl rand -hex 32
API_SHARED_SECRET=

# ── Réseau ───────────────────────────────────────────────────────────────────
# Loopback : le reverse-proxy du client doit être la seule entrée.
API_HOST=127.0.0.1
API_PORT=8080
ENVIRONMENT=prod
# Origines CORS autorisées (vide = désactivé, cas nominal serveur-à-serveur).
# Ne jamais mettre "*" : un secret partagé transite en en-tête.
CORS_ORIGINS=

# ── Exécution du pipeline ────────────────────────────────────────────────────
# Chaque pipeline ouvre jusqu'à ~12 threads (agents, recherche, scraping).
# Ne pas augmenter sans réduire d'abord SEARCH_MAX_WORKERS / SCRAPE_MAX_WORKERS.
MAX_CONCURRENT_PIPELINES=3
SLOT_ACQUIRE_TIMEOUT_S=2
PIPELINE_DEADLINE_S=600
SSE_HEARTBEAT_S=15

# ── Comportement métier ──────────────────────────────────────────────────────
# true : une question de suivi hors sujet relance automatiquement le pipeline
# complet au lieu de rendre une réponse en impasse.
FOLLOWUP_AUTO_ESCALATE=true
# Le choix des modèles est un levier de coût : laisser à false en production.
ALLOW_MODEL_OVERRIDE=false
# Protocole de streaming attendu par le front : v5 (ui-message-stream) ou v4
# (data-stream). À aligner avec la version d'AI SDK utilisée côté front.
AI_SDK_PROTOCOL=v5

# ── Limites ──────────────────────────────────────────────────────────────────
MAX_QUESTION_CHARS=4000
MAX_BODY_BYTES=65536
RATE_LIMIT_PER_HOUR=30
RATE_LIMIT_BURST_PER_MIN=3

# ── Budgets réseau ───────────────────────────────────────────────────────────
LLM_TIMEOUT_S=90
LLM_STREAM_TIMEOUT_S=180
LLM_NUM_RETRIES=1
SERPAPI_CONNECT_TIMEOUT=5
SERPAPI_READ_TIMEOUT=20
FIRECRAWL_TIMEOUT_S=45
SEARCH_MAX_WORKERS=8
SCRAPE_MAX_WORKERS=5
# Budget de l'étape de scraping entière. Indispensable : l'extraction trafilatura
# est du calcul pur, sans timeout — une page volumineuse peut bloquer sans limite.
# Au-delà, on rédige avec les documents déjà récupérés.
SCRAPE_TOTAL_TIMEOUT_S=120

# ── Journalisation ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json          # json en production, text en local
