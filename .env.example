# Clés API nécessaires pour l'application
# Copiez ce fichier en .env et remplissez vos clés API

# ── Providers LLM (via LiteLLM) ──────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
# Anthropic / Claude (ajouté pour la comparaison de modèles)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Recherche & sources ──────────────────────────────────────────────────────
SERPAPI_API_KEY=your_serpapi_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FISCALONLINE_TOKEN=your_fiscalonline_token_here

# ── Persistance (Supabase) ───────────────────────────────────────────────────
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# ── Évaluation : tracing coût/latence (Langfuse, optionnel) ──────────────────
# Si défini, chaque appel LLM est tracé dans Langfuse (coût/tokens/latence).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Évaluation : dashboard qualité (Confident AI / deepeval, optionnel) ──────
# Alternative à `deepeval login`. Le golden scoring fonctionne aussi sans (rapport console).
CONFIDENT_API_KEY=
