# Reverse-proxy nginx devant l'API fiscale.
#
# ⚠️ Les trois directives marquées « SSE » sont indispensables : sans elles,
# nginx bufferise la réponse entière et le streaming disparaît — le client reçoit
# les deux minutes de réponse d'un seul bloc, à la fin.

upstream fisca_api {
    server 127.0.0.1:8080;
    keepalive 8;
}

server {
    listen 443 ssl http2;
    server_name api-fiscal.fiscalonline.fr;

    # ssl_certificate     /etc/letsencrypt/live/.../fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/.../privkey.pem;

    # Les corps sont petits (une question) ; l'API refuse déjà au-delà de 64 Ko.
    client_max_body_size 128k;

    location / {
        proxy_pass         http://fisca_api;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # ── SSE ──────────────────────────────────────────────────────────────
        proxy_buffering          off;   # SSE : ne pas accumuler la réponse
        proxy_cache              off;   # SSE : ne jamais mettre en cache un flux
        chunked_transfer_encoding on;   # SSE : transfert au fil de l'eau

        # Un pipeline dure 1 à 5 minutes ; le défaut de 60 s couperait le flux.
        proxy_read_timeout    600s;
        proxy_send_timeout    600s;
        proxy_connect_timeout 10s;
    }

    # Sondes exemptées des logs d'accès.
    location = /health {
        proxy_pass http://fisca_api;
        access_log off;
    }
}
